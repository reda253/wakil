# Copy to .env and fill in. NEVER commit .env.
GROQ_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# Verify exact model names in Groq console / Google AI Studio before use.
GROQ_WHISPER_MODEL=whisper-large-v3
GEMINI_MODEL=gemini-flash-latest
GROQ_LLM_MODEL=
NVIDIA_LLM_MODEL=

# Set to 1 to use hard-coded stub data instead of real APIs
WAKIL_USE_STUBS=1
